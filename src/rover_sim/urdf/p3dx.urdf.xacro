<?xml version="1.0"?>
<robot name="rover" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="namespace" default="RR01" />

  <xacro:include filename="$(find rover_sim)/urdf/pioneer3dx_body.urdf.xacro" />

  <!-- Same mount as the P3-AT model until the rover jrs' lidar is measured. -->
  <xacro:include filename="$(find ros2_livox_simulation)/urdf/mid360.xacro" />
  <xacro:mid360 name="$(arg namespace)_livox" namespace="$(arg namespace)" parent="base_link" topic="mid360" >
    <origin xyz="0 0 1.0" rpy="0 0.3 0"/>
  </xacro:mid360>

</robot>
