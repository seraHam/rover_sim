<?xml version="1.0"?>
<package format="3">
  <name>rover_sim</name>
  <version>0.1.0</version>
  <description>Robot models (Pioneer 3-AT, Pioneer 3-DX), worlds and spawn launch for the rover_sim Gazebo simulation.</description>
  <maintainer email="seras@mit.edu">seraHam</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>gazebo_dev</build_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>gazebo_plugins</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ros2_livox_simulation</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <!-- gazebo_ros_paths puts these on GAZEBO_MODEL_PATH and GAZEBO_PLUGIN_PATH, with ${prefix}
         = share/rover_sim: share/, so Gazebo resolves package://rover_sim/meshes, and the
         install's lib/ for the worlds' real_time_lock plugin (gzserver would also find it
         through the colcon setup's LD_LIBRARY_PATH). -->
    <gazebo_ros gazebo_model_path="${prefix}/.." plugin_path="${prefix}/../../lib"/>
  </export>
</package>
