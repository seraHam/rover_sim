<?xml version="1.0"?>
<package format="3">
  <name>rover_sim</name>
  <version>0.1.0</version>
  <description>Robot models (Pioneer 3-AT, Pioneer 3-DX) and spawn launch for the rover_sim Gazebo simulation.</description>
  <maintainer email="seras@mit.edu">seraHam</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros2_livox_simulation</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
