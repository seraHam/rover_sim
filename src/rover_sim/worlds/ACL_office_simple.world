    <!-- A ceiling at the walls' top (2.5 m) over the corridors and rooms south of the hall (y < -3.4),
         where the RRs' z wandered with only the floor to hold it. None over the hall: there it made a
         JR slide along the hall instead (likely DLIO's adaptive mode: with a median range under 5 m it
         matches within 0.25 m instead of 1 m). Collision only, so gzclient still looks in from above.
         Its bottom is 2.5 m up: tools that take boxes for walls should skip boxes over the robots. The
         elevation mapper drops points more than max_height_range (0.5 m) above the sensor, and the 2D
         grids came out as before. -->
    <model name='rover_sim_ceiling'>
      <static>1</static>
      <pose>7.8 -12.75 2.55 0 0 0</pose>
      <link name='ceiling'>
        <collision name='c'><geometry><box><size>28.4 18.7 0.1</size></box></geometry></collision>
      </link>
    </model>
