<?xml version="1.0"?>
<!-- The empty world walled in, for the JR02-parity stack (launch/world.launch.py world:=arena).
     DLIO needs it: on a flat floor with only the other robots in view, x, y and yaw are
     unobservable to scan matching and DLIO drifts metres while parked, at any lidar density.
     Everything is inline, so nothing is fetched from a model database. -->
<sdf version="1.7">
  <world name="default">

    <!-- Physics, the same in every rover_sim world: ODE at a 1 ms step, capped at real time
         (the stack runs on wall clock), cone friction so skid steer scrubs the same way at
         any heading, standard gravity (livox_sim_bridge divides by g0 for the IMU's g). -->
    <gravity>0 0 -9.80665</gravity>
    <physics name="1ms" type="ode" default="true">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
          <!-- Each agent is its own island, and they are solved in parallel: with 4 agents
               and real_time_lock on, gzserver took 56 % of a core instead of 82 % (office,
               1000 rays) and 61 % instead of 89 % (empty, 3000 rays) for the same RTF. -->
          <island_threads>4</island_threads>
          <friction_model>cone_model</friction_model>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>
    <!-- Real-time lock (src/real_time_lock.cpp): the cap above never catches up time a step
         overran (each lidar scan holds the physics lock while it casts), so sim time fell
         behind the wall clock the stack runs on. This makes it up; it never runs ahead. -->
    <plugin name="real_time_lock" filename="librover_sim_real_time_lock.so">
      <time_constant>0.5</time_constant>
      <max_boost>0.5</max_boost>
      <max_lag>0.5</max_lag>
    </plugin>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>1</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>1</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>200 200</size></plane>
          </geometry>
          <!-- Gazebo takes the lower mu of the two surfaces: the robots' own set friction. -->
          <surface>
            <friction>
              <ode><mu>100</mu><mu2>50</mu2></ode>
            </friction>
          </surface>
          <max_contacts>10</max_contacts>
        </collision>
        <visual name="visual">
          <cast_shadows>0</cast_shadows>
          <geometry>
            <plane><normal>0 0 1</normal><size>200 200</size></plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- A 16 m room (inner faces at +-8 m, walls 2.5 m tall) and seven boxes and posts, in one
         static link. All are outside 5.5 m of the centre (the swap circle has a 4 m radius)
         and clear of the odom_eval squares by 0.9 m, and no 90 deg turn of the room maps them
         onto themselves. -->
    <model name="arena">
      <static>1</static>
      <link name="link">
        <collision name="wall_n">
          <pose>0 8.1 1.25 0 0 0</pose>
          <geometry><box><size>16.4 0.2 2.5</size></box></geometry>
        </collision>
        <visual name="wall_n_visual">
          <pose>0 8.1 1.25 0 0 0</pose>
          <geometry><box><size>16.4 0.2 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
        <collision name="wall_s">
          <pose>0 -8.1 1.25 0 0 0</pose>
          <geometry><box><size>16.4 0.2 2.5</size></box></geometry>
        </collision>
        <visual name="wall_s_visual">
          <pose>0 -8.1 1.25 0 0 0</pose>
          <geometry><box><size>16.4 0.2 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
        <collision name="wall_e">
          <pose>8.1 0 1.25 0 0 0</pose>
          <geometry><box><size>0.2 16 2.5</size></box></geometry>
        </collision>
        <visual name="wall_e_visual">
          <pose>8.1 0 1.25 0 0 0</pose>
          <geometry><box><size>0.2 16 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
        <collision name="wall_w">
          <pose>-8.1 0 1.25 0 0 0</pose>
          <geometry><box><size>0.2 16 2.5</size></box></geometry>
        </collision>
        <visual name="wall_w_visual">
          <pose>-8.1 0 1.25 0 0 0</pose>
          <geometry><box><size>0.2 16 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
        <collision name="pillar_e">
          <pose>6.4 -2 1 0 0 0</pose>
          <geometry><box><size>0.5 0.5 2</size></box></geometry>
        </collision>
        <visual name="pillar_e_visual">
          <pose>6.4 -2 1 0 0 0</pose>
          <geometry><box><size>0.5 0.5 2</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
        <collision name="crate_n">
          <pose>2.2 6.4 0.4 0 0 0.5236</pose>
          <geometry><box><size>1.2 0.6 0.8</size></box></geometry>
        </collision>
        <visual name="crate_n_visual">
          <pose>2.2 6.4 0.4 0 0 0.5236</pose>
          <geometry><box><size>1.2 0.6 0.8</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
        <collision name="post_w">
          <pose>-6.4 1.6 0.75 0 0 0</pose>
          <geometry><box><size>0.6 0.6 1.5</size></box></geometry>
        </collision>
        <visual name="post_w_visual">
          <pose>-6.4 1.6 0.75 0 0 0</pose>
          <geometry><box><size>0.6 0.6 1.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
        <collision name="bench_s">
          <pose>-1.8 -6.4 0.5 0 0 -0.3491</pose>
          <geometry><box><size>2 0.4 1</size></box></geometry>
        </collision>
        <visual name="bench_s_visual">
          <pose>-1.8 -6.4 0.5 0 0 -0.3491</pose>
          <geometry><box><size>2 0.4 1</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
        <collision name="cube_ne">
          <pose>6.6 6.6 0.5 0 0 0.7854</pose>
          <geometry><box><size>1 1 1</size></box></geometry>
        </collision>
        <visual name="cube_ne_visual">
          <pose>6.6 6.6 0.5 0 0 0.7854</pose>
          <geometry><box><size>1 1 1</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
        <collision name="locker_sw">
          <pose>-6.8 -6 1.25 0 0 0</pose>
          <geometry><box><size>0.8 0.4 2.5</size></box></geometry>
        </collision>
        <visual name="locker_sw_visual">
          <pose>-6.8 -6 1.25 0 0 0</pose>
          <geometry><box><size>0.8 0.4 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
        <collision name="screen_nw">
          <pose>-6.5 6.8 0.9 0 0 0</pose>
          <geometry><box><size>1.5 0.3 1.8</size></box></geometry>
        </collision>
        <visual name="screen_nw_visual">
          <pose>-6.5 6.8 0.9 0 0 0</pose>
          <geometry><box><size>1.5 0.3 1.8</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
