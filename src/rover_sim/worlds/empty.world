<?xml version="1.0"?>
<!-- Flat ground and a sun, for the JR02-parity stack (launch/world.launch.py world:=empty).
     Everything is inline, so nothing is fetched from a model database. -->
<sdf version="1.7">
  <world name="default">

    <!-- Physics, the same in every rover_sim world: ODE at a 1 ms step, capped at real time
         (the stack runs on wall clock), cone friction so skid steer scrubs the same way at
         any heading, standard gravity (livox_sim_bridge divides by g0 for the IMU's g). -->
    <gravity>0 0 -9.80665</gravity>
    <physics name="1ms" type="ode" default="true">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
          <!-- Each agent is its own island, and they are solved in parallel: with 4 agents
               and real_time_lock on, gzserver took 56 % of a core instead of 82 % (office,
               1000 rays) and 61 % instead of 89 % (empty, 3000 rays) for the same RTF. -->
          <island_threads>4</island_threads>
          <friction_model>cone_model</friction_model>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>
    <!-- Real-time lock (src/real_time_lock.cpp): the cap above never catches up time a step
         overran (each lidar scan holds the physics lock while it casts), so sim time fell
         behind the wall clock the stack runs on. This makes it up; it never runs ahead. -->
    <plugin name="real_time_lock" filename="librover_sim_real_time_lock.so">
      <time_constant>0.5</time_constant>
      <max_boost>0.5</max_boost>
      <max_lag>0.5</max_lag>
    </plugin>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>1</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>1</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>200 200</size></plane>
          </geometry>
          <!-- Gazebo takes the lower mu of the two surfaces: the robots' own set friction. -->
          <surface>
            <friction>
              <ode><mu>100</mu><mu2>50</mu2></ode>
            </friction>
          </surface>
          <max_contacts>10</max_contacts>
        </collision>
        <visual name="visual">
          <cast_shadows>0</cast_shadows>
          <geometry>
            <plane><normal>0 0 1</normal><size>200 200</size></plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
