# Bind-mounted from docker/dotfiles/bashrc (see docker/compose.yaml), not
# baked into the image — an edit here (from the host or live in the
# container, same file) survives down/up.
source /opt/ros/humble/setup.bash
source /home/swarm/code/rover_sim_ws/install/setup.bash
source /opt/livox_ws/install/setup.bash

### ALIASES ###
alias tks="tmux kill-session"
alias sb="source ~/.bashrc"
# run_<demo> [model:=rr|jr] [rviz:=true|false] [mapper:=acl|elevation]
# (red rover = Pioneer 3-AT, junior = Pioneer 3-DX)
unalias run_swap4 run_explore4 run_prior4 2>/dev/null
function run_session {
  local session=$1 model=rr rviz=true mapper=acl arg; shift
  for arg in "$@"; do
    case $arg in
      model:=*) model=${arg#model:=} ;;
      rviz:=true|rviz:=false) rviz=${arg#rviz:=} ;;
      mapper:=acl|mapper:=elevation) mapper=${arg#mapper:=} ;;
      *) echo "unknown argument: $arg (expected model:=rr|jr, rviz:=true|false, mapper:=acl|elevation)"; return 1 ;;
    esac
  done
  local file=/home/swarm/rover_sim/launch/$session.yaml
  if [ "$mapper" = elevation ]; then
    if [ ! -d /home/swarm/code/rover_sim_ws/install/elevation_mapping_cupy ]; then
      echo "this image has no elevation mapper; build it with: make build MAPPER=elevation"; return 1
    fi
    if grep -q PRIOR_MAP "$file"; then
      echo "$session starts from a prior map, which only the ACL mapper supports"; return 1
    fi
  fi
  if [ "$rviz" = false ]; then
    mkdir -p /tmp/rover_sim
    python3 - "$file" "/tmp/rover_sim/$session.yaml" <<'PY' || return 1
import sys, yaml
s = yaml.safe_load(open(sys.argv[1]))
for w in s['windows']:
    w['panes'] = [p for p in w['panes'] if 'rviz2 rviz2' not in str(p)]
yaml.safe_dump(s, open(sys.argv[2], 'w'), sort_keys=False)
PY
    file=/tmp/rover_sim/$session.yaml
  fi
  ROBOT_MODEL=$model USE_RVIZ=$rviz MAPPER=$mapper tmuxp load "$file"
}
function run_swap4 { run_session multi_agent_swap_demo "$@"; }
function run_explore4 { run_session office_explore_demo "$@"; }
function run_prior4 { run_session office_prior_map_demo "$@"; }
# Kills everything any sim session started (launch children, backgrounded TF publishers), then the current (or most recent) tmux session.
alias stop='pkill -9 -f "gzserver|gzclient|rviz2|ros2 launch|/rover_sim_ws/install/.*/lib/|/rover_sim/scripts/|robot_state_publisher|static_transform_publisher"; tmux kill-session 2>/dev/null; true'
