From 3036c24d02073d051f84a6235be1e2ed0fdb7de4 Mon Sep 17 00:00:00 2001
From: blakete <blakeedwards823@gmail.com>
Date: Sun, 18 Oct 2026 15:27:56 -0400
Subject: [PATCH] docker: pin rmw_zenoh from the 2026-09-14 ROS snapshot

The bare apt pin ros-humble-rmw-zenoh-cpp=0.1.9-1jammy.20260907.200640 no
longer resolves: packages.ros.org keeps only the newest build per version
and moved to 0.1.11 on 2026-10-11. zenoh-cpp-vendor was unpinned besides.

Use the same block as mighty docker/Dockerfile.hw, the rover drive
Dockerfile and mapping_ws Dockerfile.mapping: the immutable dated snapshot
2026-09-14 carries exactly the fleet pair (rmw 20260907.200640 + vendor
20260723.020902), signed by the vendored "ROS Snapshot builder" key
(fingerprint asserted), with apt-mark hold and a dpkg-query tripwire.

The key goes in keys/ rather than docker/keys/ because .dockerignore drops
docker/ from the build context.

Claude-Session: https://claude.ai/code/session_01QBCWc95CLQNQd4oPCWmiXC
---
 docker/Dockerfile                     |  42 ++++++++---
 keys/ros-snapshot-archive-keyring.asc | 100 ++++++++++++++++++++++++++
 2 files changed, 134 insertions(+), 8 deletions(-)
 create mode 100644 keys/ros-snapshot-archive-keyring.asc

diff --git a/docker/Dockerfile b/docker/Dockerfile
index f88ad22..d96ea3e 100644
--- a/docker/Dockerfile
+++ b/docker/Dockerfile
@@ -53,17 +53,43 @@ WORKDIR ${WS}
 # layer does not depend on the source tree.
 COPY --from=build ${WS}/src/direct_lidar_inertial_odometry/package.xml \
                   manifests/direct_lidar_inertial_odometry/package.xml
-# rmw_zenoh pinned 2026-09-18 to the C2 cart laptop's snapshot. Builds between
-# 20260820 and 20260907 are NOT graph-compatible: liveliness tokens stop resolving
-# across the gap, so pub/sub data still flows while service discovery dies -- which
-# is what broke C2 teleop (set_mode 'service not ready'). Keep this equal to the C2
-# and to the other rover images; moving one side alone re-splits the graph.
-RUN apt-get update && rosdep update \
+# RMW PIN (same scheme as mighty docker/Dockerfile.hw and the rover drive Dockerfile):
+# every container on a rover must run the SAME rmw_zenoh build, and this one must equal
+# the C2 too. Builds between 20260820 and 20260907 are NOT graph-compatible: liveliness
+# tokens stop resolving across the gap, so pub/sub data still flows while service
+# discovery dies -- which is what broke C2 teleop (set_mode 'service not ready'). Two
+# builds both called 0.1.9 also dropped TRANSIENT_LOCAL /tf_static between images on
+# RR08 (2026-09-17). Moving one side alone re-splits the graph.
+# 2026-10-11: packages.ros.org moved to 0.1.11 and dropped 0.1.9-1jammy.20260907.200640
+# (it keeps only the newest build per version), so the bare apt pin that was here stopped
+# resolving and the unpinned vendor would have drifted with it. The dated snapshot
+# 2026-09-14 carries exactly the fleet pair (rmw 20260907.200640 + vendor 20260723.020902);
+# snapshots are immutable, and Pin-Priority 1001 also covers rosdep's own install of
+# rmw_zenoh_cpp. The snapshot repo is signed by "ROS Snapshot builder" (vendored key,
+# fingerprint asserted); apt-mark hold + dpkg-query make any drift fail the build.
+# The key lives in keys/, not docker/keys/: .dockerignore drops docker/ from the context.
+ARG ROS_SNAPSHOT=2026-09-14
+ARG RMW_ZENOH_CPP_VER=0.1.9-1jammy.20260907.200640
+ARG ZENOH_CPP_VENDOR_VER=0.1.9-1jammy.20260723.020902
+ARG ROS_SNAPSHOT_KEY_FPR=4B63CF8FDE49746E98FA01DDAD19BAB3CBF125EA
+COPY keys/ros-snapshot-archive-keyring.asc /tmp/ros-snapshot.asc
+RUN gpg --dearmor < /tmp/ros-snapshot.asc > /usr/share/keyrings/ros-snapshot-archive-keyring.gpg \
+ && gpg --show-keys --with-colons /tmp/ros-snapshot.asc | awk -F: '/^fpr/{print $10; exit}' \
+      | grep -qx "${ROS_SNAPSHOT_KEY_FPR}" \
+ && rm -f /tmp/ros-snapshot.asc \
+ && echo "deb [signed-by=/usr/share/keyrings/ros-snapshot-archive-keyring.gpg] http://snapshots.ros.org/humble/${ROS_SNAPSHOT}/ubuntu jammy main" \
+        > /etc/apt/sources.list.d/ros2-snapshot.list \
+ && printf 'Package: ros-humble-rmw-zenoh-cpp ros-humble-zenoh-cpp-vendor\nPin: origin snapshots.ros.org\nPin-Priority: 1001\n' \
+        > /etc/apt/preferences.d/99-rmw-zenoh-pin \
+ && apt-get update && rosdep update \
  && rosdep install -y -r --ignore-src --dependency-types exec --from-paths manifests \
  && apt-get install -y --no-install-recommends \
-      ros-humble-rmw-zenoh-cpp=0.1.9-1jammy.20260907.200640 \
-      ros-humble-zenoh-cpp-vendor \
+      ros-humble-rmw-zenoh-cpp=${RMW_ZENOH_CPP_VER} \
+      ros-humble-zenoh-cpp-vendor=${ZENOH_CPP_VENDOR_VER} \
       ros-humble-tf2-ros \
+ && apt-mark hold ros-humble-rmw-zenoh-cpp ros-humble-zenoh-cpp-vendor \
+ && test "$(dpkg-query -W -f='${Version}' ros-humble-rmw-zenoh-cpp)" = "${RMW_ZENOH_CPP_VER}" \
+ && test "$(dpkg-query -W -f='${Version}' ros-humble-zenoh-cpp-vendor)" = "${ZENOH_CPP_VENDOR_VER}" \
  && rm -rf /var/lib/apt/lists/* manifests
 
 # Baked workspace (cheap COPY layers last, so the apt layer above stays cached).
diff --git a/keys/ros-snapshot-archive-keyring.asc b/keys/ros-snapshot-archive-keyring.asc
new file mode 100644
index 0000000..1cb0b68
--- /dev/null
+++ b/keys/ros-snapshot-archive-keyring.asc
@@ -0,0 +1,100 @@
