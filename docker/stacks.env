# docker/stacks.env — THE pin file for the per-stack sim images (scripts/build_images.sh).
#
# Each robot stack runs in the sim from the image its own repo's Dockerfile builds, at
# the commit below. Bump a pin by changing its *_SHA and the short sha in its *_IMAGE
# together (build_images.sh refuses a tag that does not carry the pinned sha), then
# `make images`. Pins are the newest pushed heads of the branches JR02 deploys; re-verify
# against the robot before each PR (see the plan's "Target pins").
#
# Format: plain KEY=VALUE lines. No quotes, no ${...}, no `export`, no trailing comments,
# so the same file is parsed by build_images.sh and sim.py and works as a compose
# --env-file.

# ---------- base + RMW (fleet-wide state) ------------------------------------------------
# The upstream Dockerfiles say `FROM ros:humble-ros-base` (floating). build_images.sh
# pins it to this digest with a buildx named context instead of patching each one. This
# is the base every robot-equivalent image on alienware-02 was built from
# (mighty-hw:main-3cf7320, rover-mapping:composite-map-b226206,
# rover-drive:jr02-ros2-0dc816f all share its 10 layers).
ROS_BASE_IMAGE=ros:humble-ros-base@sha256:1813d3c85d7f96ff7d3012d865204583255740182db5d0065f8f8cd029a83138
# Every image must carry exactly this rmw_zenoh build: two builds both called 0.1.9 are
# not wire-compatible for TRANSIENT_LOCAL (/tf_static). From the immutable dated ROS
# snapshot (mighty docker/Dockerfile.hw:135-193); build_images.sh checks each image
# with dpkg-query after it is built or reused.
ROS_SNAPSHOT=2026-09-14
RMW_ZENOH_CPP_VER=0.1.9-1jammy.20260907.200640
ZENOH_CPP_VENDOR_VER=0.1.9-1jammy.20260723.020902
ROS_SNAPSHOT_KEY_FPR=4B63CF8FDE49746E98FA01DDAD19BAB3CBF125EA

# ---------- mighty: planner, goal_selector, convert_odom_to_state, mpc --------------------
# docker/Dockerfile.hw, repo-root context. Deps (mpc, goal_selector_msgs, dynus_interfaces,
# DecompROS2) are cloned inside the build at the mighty.repos pins.
MIGHTY_REPO=git@github.com:blakete/mighty.git
MIGHTY_SHA=3cf7320736043e737c13fa4a705919918db7bf1a
MIGHTY_IMAGE=rover-sim/mighty-hw:3cf7320

# ---------- mapping: global_mapper + map_fusion + persistent_map ---------------------------
# mapping_ws docker/Dockerfile.mapping, repo-root context. acl-mapping f44e045,
# map_fusion 8ea4ca7 and dynus_interfaces c43bcec are cloned inside the build.
MAPPING_REPO=git@gitlab.com:mit-acl/ugv/redrover/mapping_ws.git
MAPPING_SHA=c1233f78eae7dab33ab881efab7bd7d59b679fdf
MAPPING_IMAGE=rover-sim/mapping:c1233f7

# ---------- dlio: one image per robot class --------------------------------------------------
# dlio_ws docker/Dockerfile, ws-root context with src/ imported from dlio.repos. ROBOT_NAME
# bakes cfg_overlay/<robot>/ (lidar extrinsic, crop box), so each sim class gets the image
# of the real robot it is calibrated from. Patched by docker/patches/dlio_ws/.
DLIO_REPO=git@github.com:blakete/dlio_ws.git
DLIO_SHA=e67633154e7f41ed957cd3f29ba144d89ca85925
DLIO_JR_ROBOT=JR02
DLIO_JR_IMAGE=rover-sim/dlio:e676331-JR02
DLIO_RR_ROBOT=RR08
DLIO_RR_IMAGE=rover-sim/dlio:e676331-RR08

# ---------- drive: zenoh router, safety_node/teleop, rover_description -----------------------
# rover rover_bringup/docker/Dockerfile, ws-root context with the repo at src/rover and its
# acl_ctrl_safety submodule (5cb2be0) initialised.
DRIVE_REPO=git@gitlab.com:mit-acl/ugv/redrover/rover.git
DRIVE_SHA=9b0b4ba5e56930b67fd2061a395e926147ca99b2
DRIVE_IMAGE=rover-sim/drive:9b0b4ba

# ---------- gazebo + elevation: this repo's docker/Dockerfile targets -------------------------
# Both FROM stack-base (ROS_BASE_IMAGE + the RMW pin above, passed as STACK_BASE_IMAGE etc.).
# gazebo: gzserver/gui, the rover_sim package, sim plugins (rover_sim.sim.repos), RViz.
# Built from this checkout, hence :local.
GAZEBO_IMAGE=rover-sim/gazebo:local
# elevation: elevation_mapping_cupy + ros2_numpy and their pip CUDA deps (the robot runs it
# natively on its Orin). The pins reach docker/Dockerfile as STACK_ELEVATION_GIT_* and
# STACK_ROS2_NUMPY_GIT_* build args.
ELEVATION_REPO=https://github.com/blakete/elevation_mapping_cupy.git
ELEVATION_SHA=43803679774cd04b36007aca84577b74999e9771
ROS2_NUMPY_REPO=https://github.com/Box-Robotics/ros2_numpy.git
ROS2_NUMPY_SHA=d5ebf723e1d2457d36fa89bf021b212e340c3c11
ELEVATION_IMAGE=rover-sim/elevation:4380367
