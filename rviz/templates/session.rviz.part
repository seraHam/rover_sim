# rover_sim RViz config for session @SESSION@, generated by scripts/sim.py (rviz_config) from
# rviz/templates/: session.rviz.part, one agent.rviz.part per agent (agent_gpu.rviz.part inside
# it for mapping: gpu), footer.rviz.part. Rewritten on every `up` and `sim.py start rviz`: edit
# the templates, not this file. Fixed Frame `world` (sim_tf.py's world -> <ns>/map, the spawn pose).
Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Tree Height: 700
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz_common/Views
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 24
      Reference Frame: <Fixed Frame>
      Value: true
    # Off: every agent has its own Axes on <ns>/base_link. TF data comes in either way.
    - Class: rviz_default_plugins/TF
      Enabled: false
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        {}
      Update Interval: 0
      Value: false
